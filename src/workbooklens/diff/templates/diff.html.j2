<!doctype html><html lang="{{ language }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ t('diff.title') }}</title><style>
:root{color-scheme:light dark;--bg:#f5f7fb;--card:#fff;--ink:#172033;--muted:#64748b;--line:#dce3ee;--error:#c24135;--warning:#a15c00;--info:#1769aa}
@media(prefers-color-scheme:dark){:root{--bg:#10131a;--card:#181d27;--ink:#edf2f7;--muted:#a7b2c3;--line:#303849}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Arial,sans-serif}main{max-width:1200px;margin:auto;padding:28px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;margin:16px 0}.muted{color:var(--muted)}.controls{display:flex;gap:12px;flex-wrap:wrap}
select,input{font:inherit;color:inherit;background:var(--card);border:1px solid var(--line);border-radius:7px;padding:8px}table{width:100%;border-collapse:collapse}th,td{text-align:left;vertical-align:top;border-bottom:1px solid var(--line);padding:10px}
.badge{color:#fff;border-radius:99px;padding:2px 8px;font-size:12px}.error{background:var(--error)}.warning{background:var(--warning)}.info{background:var(--info)}.critical{background:#8b1e2d}.hidden{display:none}code{overflow-wrap:anywhere}.scroll{overflow:auto;max-height:72vh}
</style></head><body><main><h1>{{ t('diff.heading') }}</h1><div class="muted">{{ t('diff.before') }} {{ diff.before_sha256 }}<br>{{ t('diff.after') }} {{ diff.after_sha256 }}</div>
<section class="card">{{ t('diff.summary', cells=diff.cell_changes|length, structures=diff.structural_changes|length) }}</section>
<div class="controls"><label>{{ t('diff.sheet') }} <select id="sheet"><option value="">{{ t('report.all') }}</option>{% for name in diff.cell_changes|map(attribute='sheet')|unique|sort %}<option>{{ name }}</option>{% endfor %}</select></label>
<label>{{ t('diff.type') }} <select id="type"><option value="">{{ t('report.all') }}</option><option value="value">{{ change_type_label('value') }}</option><option value="formula">{{ change_type_label('formula') }}</option><option value="style">{{ change_type_label('style') }}</option><option value="number_format">{{ change_type_label('number_format') }}</option><option value="structure">{{ change_type_label('structure') }}</option></select></label>
<label>{{ t('diff.importance') }} <select id="importance"><option value="">{{ t('report.all') }}</option><option value="critical">{{ severity_label('critical') }}</option><option value="error">{{ severity_label('error') }}</option><option value="warning">{{ severity_label('warning') }}</option><option value="info">{{ severity_label('info') }}</option></select></label>
<label>{{ t('diff.search') }} <input id="search" type="search"></label></div>
<section class="card scroll"><table><thead><tr><th>{{ t('diff.importance') }}</th><th>{{ t('diff.type') }}</th><th>{{ t('diff.subject') }}</th><th>{{ t('diff.before') }}</th><th>{{ t('diff.after') }}</th></tr></thead><tbody id="changes">
{% for change in diff.cell_changes %}<tr data-sheet="{{ change.sheet }}" data-type="{{ change.change_type }}" data-importance="{{ change.importance.value }}"><td><span class="badge {{ change.importance.value }}">{{ severity_label(change.importance) }}</span></td><td>{{ change_type_label(change.change_type) }}</td><td>{{ change.sheet }}!{{ change.cell }}</td><td><code>{{ change.before }}</code>{% if change.before_signature %}<br><small>{{ change.before_signature }}</small>{% endif %}</td><td><code>{{ change.after }}</code>{% if change.after_signature %}<br><small>{{ change.after_signature }}</small>{% endif %}</td></tr>{% endfor %}
{% for change in diff.structural_changes %}<tr data-sheet="" data-type="structure" data-importance="{{ change.importance.value }}"><td><span class="badge {{ change.importance.value }}">{{ severity_label(change.importance) }}</span></td><td>{{ change_type_label(change.change_type) }}</td><td>{{ change.subject }}</td><td><code>{{ change.before }}</code></td><td><code>{{ change.after }}</code></td></tr>{% endfor %}
</tbody></table>{% if not diff.cell_changes and not diff.structural_changes %}<p>{{ t('diff.no_changes') }}</p>{% endif %}</section>
<p class="muted">{{ t('diff.privacy') }}</p></main><script>
const cs=[...document.querySelectorAll('select,input')];function f(){const s=document.querySelector('#sheet').value,t=document.querySelector('#type').value,i=document.querySelector('#importance').value,q=document.querySelector('#search').value.toLowerCase();document.querySelectorAll('#changes tr').forEach(r=>r.classList.toggle('hidden',!!((s&&r.dataset.sheet!==s)||(t&&r.dataset.type!==t)||(i&&r.dataset.importance!==i)||(q&&!r.textContent.toLowerCase().includes(q)))))}cs.forEach(c=>c.addEventListener('input',f));
</script></body></html>
