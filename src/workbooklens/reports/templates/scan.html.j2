<!doctype html>
<html lang="{{ language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ t('report.scan_title') }} — {{ source }}</title>
  <style>
    :root { color-scheme: light dark; --bg:#f5f7fb; --card:#fff; --ink:#172033;
      --muted:#64748b; --line:#dce3ee; --critical:#8b1e2d; --error:#c24135;
      --warning:#a15c00; --info:#1769aa; --accent:#3157d5; }
    @media (prefers-color-scheme: dark) { :root { --bg:#10131a; --card:#181d27;
      --ink:#edf2f7; --muted:#a7b2c3; --line:#303849; --accent:#8da2ff; } }
    * { box-sizing:border-box; } body { margin:0; font:15px/1.55 Arial,sans-serif;
      color:var(--ink); background:var(--bg); } main { max-width:1200px; margin:auto; padding:28px; }
    h1 { margin:0 0 4px; font-size:30px; } h2 { margin-top:0; } .muted { color:var(--muted); }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:14px;
      margin:22px 0; } .card { background:var(--card); border:1px solid var(--line);
      border-radius:12px; padding:16px; box-shadow:0 4px 18px #0000000a; }
    .metric { font-size:28px; font-weight:700; } .controls { display:flex; flex-wrap:wrap;
      gap:10px; margin:18px 0; } label { font-weight:600; } select,input { font:inherit;
      color:inherit; background:var(--card); border:1px solid var(--line); border-radius:7px;
      padding:8px 10px; } input { min-width:260px; }
    table { width:100%; border-collapse:collapse; } th,td { text-align:left; vertical-align:top;
      border-bottom:1px solid var(--line); padding:11px 9px; } th { position:sticky; top:0;
      background:var(--card); } .table-wrap { overflow:auto; max-height:70vh; }
    .badge { display:inline-block; border-radius:99px; padding:2px 8px; color:#fff;
      font-size:12px; font-weight:700; } .critical { background:var(--critical); }
    .error { background:var(--error); } .warning { background:var(--warning); }
    .info { background:var(--info); } code { overflow-wrap:anywhere; } details { margin-top:6px; }
    .privacy { border-left:4px solid var(--accent); } .hidden { display:none; }
    .location { white-space:nowrap; } .score { color:var(--error); }
    .policy { border-left:4px solid var(--warning); }
    @media (max-width:700px) { main { padding:16px; } th:nth-child(4),td:nth-child(4) { display:none; } }
  </style>
</head>
<body><main>
  <header><h1>{{ t('report.scan_title') }}</h1><div class="muted">{{ source }} · SHA-256 {{ source_sha256 }}</div></header>
  <section class="grid" aria-label="{{ t('report.workbook_summary') }}">
    <div class="card"><div class="muted">{{ t('report.weighted_score') }}</div><div class="metric score">{{ weighted_finding_score }}</div>
      <small class="muted">{{ t('report.score_help') }}</small></div>
    <div class="card"><div class="muted">{{ t('report.critical') }}</div><div class="metric">{{ severity_counts.get('critical', 0) }}</div></div>
    <div class="card"><div class="muted">{{ t('report.errors') }}</div><div class="metric">{{ severity_counts.get('error', 0) }}</div></div>
    <div class="card"><div class="muted">{{ t('report.warnings') }}</div><div class="metric">{{ severity_counts.get('warning', 0) }}</div></div>
    <div class="card"><div class="muted">{{ t('report.active_total') }}</div><div class="metric">{{ policy_summary.active }} / {{ policy_summary.total }}</div></div>
  </section>
  <section class="card privacy"><strong>{{ t('report.local_title') }}</strong> {{ t('report.local_body') }}</section>
  {% if baseline_path or suppressed_findings or expired_suppression_ids %}
  <section class="card policy" style="margin-top:16px"><h2>{{ t('report.policy_title') }}</h2>
    {% if baseline_path %}<p>{{ t('report.baseline_active') }}{% if new_only %}; {{ t('report.new_only') }}{% endif %}.
      {{ t('report.baseline_counts', baseline_known=policy_summary.baseline_known, new=policy_summary.new) }}</p>{% endif %}
    {% if suppressed_findings %}<p>{{ t('report.suppressed_count', count=policy_summary.suppressed) }}</p>{% endif %}
    {% if expired_suppression_ids %}<p><b>{{ t('report.expired_suppressions') }}</b> {{ expired_suppression_ids|join(', ') }}</p>{% endif %}
  </section>
  {% endif %}
  <section class="card" style="margin-top:16px"><h2>{{ t('report.sheet_overview') }}</h2>
    <div class="table-wrap"><table><thead><tr><th>{{ t('report.sheet') }}</th><th>{{ t('report.state') }}</th><th>{{ t('report.relevant_cells') }}</th><th>{{ t('report.content_range') }}</th><th>{{ t('report.declared_range') }}</th><th>{{ t('report.saved_view') }}</th></tr></thead><tbody>
      {% for sheet in sheets %}<tr><td>{{ sheet.name }}</td><td>{{ t('sheet_state.' ~ sheet.state, default=sheet.state) }}</td><td>{{ sheet.cells|length }}</td>
        <td><code>{{ sheet.content_dimension or '—' }}</code></td><td><code>{{ sheet.declared_dimension or '—' }}</code></td>
        <td><code>{{ sheet.view_top_left_cell or 'A1' }}</code>{% if sheet.view_zoom_scale %} · {{ sheet.view_zoom_scale }}%{% endif %}</td></tr>{% endfor %}
    </tbody></table></div></section>
  <section class="card" style="margin-top:16px"><h2>{{ t('report.findings') }}</h2>
    <div class="controls">
      <label>{{ t('report.severity') }} <select id="severity"><option value="">{{ t('report.all') }}</option><option value="critical">{{ severity_label('critical') }}</option><option value="error">{{ severity_label('error') }}</option><option value="warning">{{ severity_label('warning') }}</option><option value="info">{{ severity_label('info') }}</option></select></label>
      <label>{{ t('report.sheet') }} <select id="sheet"><option value="">{{ t('report.all') }}</option>{% for sheet in sheets %}<option>{{ sheet.name }}</option>{% endfor %}</select></label>
      <label>{{ t('report.rule') }} <select id="rule"><option value="">{{ t('report.all') }}</option>{% for rule, count in rule_counts %}<option value="{{ rule }}">{{ rule }} ({{ count }})</option>{% endfor %}</select></label>
      <label>{{ t('report.search') }} <input id="search" type="search" placeholder="{{ t('report.search_placeholder') }}"></label>
      <label>{{ t('report.sort') }} <select id="sort"><option value="risk">{{ t('report.sort_risk') }}</option><option value="rule">{{ t('report.sort_rule') }}</option><option value="location">{{ t('report.sort_location') }}</option></select></label>
    </div>
    <div class="table-wrap"><table><thead><tr><th>{{ t('report.severity') }}</th><th>{{ t('report.rule') }}</th><th>{{ t('report.location') }}</th><th>{{ t('report.confidence') }}</th><th>{{ t('report.explanation_evidence') }}</th></tr></thead><tbody id="findings">
    {% for finding in findings %}<tr data-order="{{ loop.index0 }}" data-severity="{{ finding.severity.value }}" data-sheet="{{ finding.sheet or '' }}" data-location="{{ finding.location or '' }}" data-rule="{{ finding.rule_id }}">
      <td><span class="badge {{ finding.severity.value }}">{{ severity_label(finding.severity) }}</span></td>
      <td><code>{{ finding.rule_id }}</code></td>
      <td class="location">{{ finding.sheet or t('web.results_workbook_scope') }}{% if finding.location %}!{{ finding.location }}{% endif %}</td>
      <td>{{ '%.0f'|format(finding.confidence.root * 100) }}%</td>
      <td><strong>{{ finding.title }}</strong><br>{{ finding.explanation }}
        <details><summary>{{ t('report.evidence') }}</summary><p>{{ finding.evidence.summary }}</p>
          <p><b>{{ t('report.observed') }}</b> <code>{{ finding.evidence.observed }}</code></p>
          <p><b>{{ t('report.expected') }}</b> <code>{{ finding.evidence.expected }}</code></p>
          {% if finding.evidence.peers %}<p><b>{{ t('report.peers') }}</b> {{ finding.evidence.peers|join(', ') }}</p>{% endif %}
          <p><b>{{ t('report.suggested_action') }}</b> {{ finding.suggested_action }}</p>
          {% for patch_id in finding.patch_ids %}{% set patch = patch_map.get(patch_id) %}{% if patch %}
          <p><b>{{ t('report.patch') }} {{ patch.id }}</b> ({{ patch_kind_label(patch.kind) }}, {{ risk_label(patch.risk) }}, {{ t('report.safe_only') }}={{ t('common.yes') if patch.safe_only_eligible else t('common.no') }}):
            <br>{{ patch.description }}<br><code>{{ patch.before }}</code> → <code>{{ patch.after }}</code></p>{% endif %}{% endfor %}
        </details></td></tr>{% endfor %}
    </tbody></table></div>
    {% if not findings %}
      {% if policy_summary.total == 0 %}
      <p>{{ t('report.no_findings') }}</p>
      {% else %}
      <p>{{ t('report.no_active_findings', baseline_known=policy_summary.baseline_known, suppressed=policy_summary.suppressed) }}</p>
      {% endif %}
    {% endif %}
  </section>
  {% if suppressed_findings %}
  <section class="card" style="margin-top:16px"><h2>{{ t('report.suppressed_findings') }}</h2>
    <p>{{ t('report.suppressed_help') }}</p>
    <div class="table-wrap"><table><thead><tr><th>{{ t('report.rule') }}</th><th>{{ t('report.location') }}</th><th>{{ t('report.waiver') }}</th><th>{{ t('report.reason') }}</th></tr></thead><tbody>
      {% for item in suppressed_findings %}<tr><td><code>{{ item.finding.rule_id }}</code></td>
        <td>{{ item.finding.sheet or t('web.results_workbook_scope') }}{% if item.finding.location %}!{{ item.finding.location }}{% endif %}</td>
        <td><code>{{ item.suppression_id }}</code>{% if item.expires %}<br>{{ t('report.expires') }} {{ item.expires }}{% endif %}</td>
        <td>{{ item.reason }}</td></tr>{% endfor %}
    </tbody></table></div>
  </section>
  {% endif %}
  <section class="card" style="margin-top:16px"><h2>{{ t('report.limitations') }}</h2><p>{{ t('report.limitations_body') }}</p></section>
  <footer class="muted" style="margin-top:18px">{{ t('report.generated', version=tool_version) }}</footer>
</main><script>
  const controls=[...document.querySelectorAll('#severity,#sheet,#rule,#search,#sort')];
  function filter(){const sev=document.querySelector('#severity').value, sheet=document.querySelector('#sheet').value,
    rule=document.querySelector('#rule').value, q=document.querySelector('#search').value.toLowerCase();
    const sort=document.querySelector('#sort').value, body=document.querySelector('#findings'), rows=[...body.querySelectorAll('tr')];
    rows.sort((a,b)=>sort==='rule'?(a.dataset.rule+a.dataset.sheet+a.dataset.location).localeCompare(b.dataset.rule+b.dataset.sheet+b.dataset.location):sort==='location'?(a.dataset.sheet+a.dataset.location).localeCompare(b.dataset.sheet+b.dataset.location):Number(a.dataset.order)-Number(b.dataset.order));
    rows.forEach(row=>body.appendChild(row));
    document.querySelectorAll('#findings tr').forEach(row=>{const ok=(!sev||row.dataset.severity===sev)&&
      (!sheet||row.dataset.sheet===sheet)&&(!rule||row.dataset.rule===rule)&&(!q||row.textContent.toLowerCase().includes(q));
      row.classList.toggle('hidden',!ok);});} controls.forEach(control=>control.addEventListener('input',filter));
</script></body></html>
